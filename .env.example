# Copy this file to ".env" and fill it in. Never share or commit .env.
# Without an email provider, verification codes CANNOT be sent, so nobody can raise a case.
# (Developers only: ALLOW_DEV_OTP=1 shows the code on screen instead of emailing it.)

# --- Option A: Gmail / any SMTP server (works locally) ---
# Gmail needs an "App password": Google Account > Security > 2-Step Verification > App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourname@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=yourname@gmail.com

# --- Option B: Brevo HTTPS API (use this on hosts that block SMTP, e.g. Render free) ---
# If BREVO_API_KEY is set it is used instead of SMTP.
# BREVO_API_KEY=
# BREVO_SENDER=you@example.com     (must be a verified sender in Brevo)

# --- Staff dashboard PIN (leave unset = dashboard open; ALWAYS set it when deployed) ---
# STAFF_PIN=change-me

# --- Link shown inside emails ---
PUBLIC_URL=http://127.0.0.1:8000

# --- Optional: Claude for smarter complaint understanding ---
# ANTHROPIC_API_KEY=
