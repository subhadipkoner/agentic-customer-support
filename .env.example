# Copy this file to ".env" and fill it in. Never share or commit .env.
# Without SMTP_HOST, verification codes CANNOT be sent, so nobody can raise a case.
# (Developers only: ALLOW_DEV_OTP=1 shows the code on screen instead of emailing it.)

# --- Real email (Gmail example) ---
# Use a Gmail "App password": Google Account > Security > 2-Step Verification > App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourname@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=yourname@gmail.com

# --- Staff dashboard PIN (default: staff123) ---
STAFF_PIN=change-me

# --- Link shown inside emails ---
PUBLIC_URL=http://127.0.0.1:8000

# --- Optional: Claude for smarter complaint understanding ---
# ANTHROPIC_API_KEY=
